  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "wdio": "wdio run ./wdio.conf.ts",
    "test:web": "wdio run wdio.conf.ts",
    "test:api": "mocha --require ts-node/register \"test/specs/api/**/*.api.ts\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "test:web:report": "npm run test:web && npm run allure:generate",
    "test:api:report": "npm run test:api && npm run allure:generate",
    "test:all:report": "npm run test:web && npm run test:api && npm run allure:generate && npm run allure:open"


  },
